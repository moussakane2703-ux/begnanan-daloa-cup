# Copiez ce fichier en .env.local pour travailler en local,
# et renseignez les mêmes variables dans Vercel (Settings > Environment Variables).

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète : uniquement côté serveur, ne jamais la partager ni la publier.
SUPABASE_SERVICE_ROLE_KEY=

# Facultatif : envoi automatique des annonces par WhatsApp (compte WhatsApp Business Platform de Meta).
# Sans ces valeurs, le comité partage les annonces à la main depuis l'espace admin.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
# WHATSAPP_TEMPLATE_LANG=fr

# Facultatif : paiement des billets avec Wave Business (portail Wave Business > Développeurs).
# Avec WAVE_API_KEY, les supporters paient sur Wave au moment de la réservation ; sans, ils paient sur place.
# Secrets : uniquement dans Vercel, jamais dans le code ni par message.
WAVE_API_KEY=
# Secret du webhook (wave_sn_WHS_…), webhook à déclarer sur https://www.begnanandaloacup.com/api/wave/webhook
WAVE_WEBHOOK_SECRET=
# Seulement si la clé API a été créée avec « signature des requêtes » activée (wave_sn_AKS_…).
WAVE_SIGNING_SECRET=
